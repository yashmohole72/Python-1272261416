      "id": "47b5e12e-3733-47ed-b588-df29f9406617",
      "name": "Get Backed-up Files (Deletion)",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        64,
        1232
      ]
    },
    {
      "parameters": {
        "jsCode": "const tz = 'Asia/Kolkata';\nconst today = DateTime.now().setZone(tz).startOf('day');\nconst toDt = (v) => (v instanceof Date ? DateTime.fromJSDate(v) : DateTime.fromISO(String(v)));\nconst groups = {};\nfor (const item of $input.all()) {\n  const r = item.json;\n  if (!r || !r.user_email || !r.deletion_date) continue;\n  const del = toDt(r.deletion_date);\n  if (!del.isValid) continue;\n  const delDay = del.setZone(tz).startOf('day');\n  const days = Math.round(delDay.diff(today, 'days').days);\n  let notice = null;\n  if (days <= 0) {\n    if (r.deleted_notice_sent !== true) notice = 'deleted';\n  } else if (days === 1) {\n    if (r.reminder_1_sent !== true) notice = 'r1';\n  } else if (days <= 3) {\n    if (r.reminder_3_sent !== true) notice = 'r3';\n  } else if (days <= 7) {\n    if (r.reminder_7_sent !== true) notice = 'r7';\n  }\n  if (!notice) continue;\n  const level = { r7: 1, r3: 2, r1: 3, deleted: 4 }[notice];\n  const groupDays = notice === 'deleted' ? 0 : days;\n  const key = String(r.user_email).trim().toLowerCase() + '|' + notice + '|' + groupDays;\n  if (!groups[key]) {\n    groups[key] = { user_email: String(r.user_email).trim(), user_name: r.user_name || 'there', notice, days: groupDays, files: [], rows: [] };\n  }\n  groups[key].files.push({ file_name: r.file_name, deletion_date: delDay.toFormat('dd LLL yyyy') });\n  groups[key].rows.push({\n    row_id: r.id,\n    set_r7: r.reminder_7_sent === true || level >= 1,\n    set_r3: r.reminder_3_sent === true || level >= 2,\n    set_r1: r.reminder_1_sent === true || level >= 3,\n    set_deleted: r.deleted_notice_sent === true || level >= 4,\n  });\n}\nreturn Object.values(groups).map((g) => {\n  const n = g.files.length;\n  const list = '<ul>' + g.files.map((f) => '<li><b>' + f.file_name + '</b> (deletion date: ' + f.deletion_date + ')</li>').join('') + '</ul>';\n  let subject;\n  let body;\n  if (g.notice === 'deleted') {\n    subject = 'CloudSync: ' + n + ' file(s) have been deleted';\n    body = '<p>The following file(s) reached their auto-deletion date and have been removed from your CloudSync backup:</p>' + list +\n      '<p>If you still need them, please upload them again.</p>';\n  } else {\n    const when = g.days === 1 ? 'tomorrow (in 1 day)' : 'in ' + g.days + ' days';\n    subject = 'CloudSync reminder: ' + n + ' file(s) will be deleted ' + when;\n    body = '<p>This is a reminder that the following file(s) will be automatically deleted ' + when + ':</p>' + list +\n      '<p>Download or re-back up anything you want to keep before the deletion date.</p>';\n  }\n  const html = '<p>Hi ' + g.user_name + ',</p>' + body + '<p>- The CloudSync Team</p>';\n  return { json: { user_email: g.user_email, user_name: g.user_name, notice_type: g.notice, days_left: g.days, file_count: n, subject, html, rows: g.rows } };\n});"
      },
      "id": "48fb9996-7a3b-4261-8857-9c9f82d040bc",
