        "subject": "={{ $json.event_type === 'file_corrupted' ? 'CloudSync alert: ' + $json.file_name + ' is corrupted' : 'CloudSync alert: backup failed for ' + $json.file_name }}",
        "message": "=<p>Hi {{ $json.user_name }},</p><p>{{ $json.event_type === 'file_corrupted' ? 'We detected that your file <b>' + $json.file_name + '</b> is corrupted and could not be backed up to the cloud.' : 'We could not back up your file <b>' + $json.file_name + '</b> to the cloud.' }}</p><p><b>Time:</b> {{ DateTime.fromISO(String($json.event_time)).isValid ? DateTime.fromISO(String($json.event_time)).setZone('Asia/Kolkata').toFormat('dd LLL yyyy, HH:mm') : $json.event_time }}{{ $json.error_message ? '<br><b>Details:</b> ' + $json.error_message : '' }}</p><p>Please check the file and try again. CloudSync will retry on the next backup run.</p><p>- The CloudSync Team</p>",
        "options": {
          "appendAttribution": false,
          "senderName": "CloudSync"
        }
      },
