    {
      "parameters": {
        "jsCode": "const ev = $('Normalize Event').first().json;\nconst email = String(ev.user_email || '').trim().toLowerCase();\nconst match = $input.all().map((i) => i.json).find((r) => r && r.id && String(r.user_email || '').trim().toLowerCase() === email && String(r.file_name || '') === String(ev.file_name || ''));\nreturn [{ json: Object.assign({}, ev, { existing_row_id: match ? match.id : null }) }];"
      },
