          "assignments": [
            {
              "id": "a1",
              "name": "event_type",
              "type": "string",
              "value": "={{ (() => { const t = String($json.body.event_type || $json.body.event || $json.body.status || '').toLowerCase(); if (t.includes('corrupt')) return 'file_corrupted'; if (t.includes('fail') || t.includes('error')) return 'backup_failed'; if (t.includes('success') || t.includes('complete')) return 'backup_success'; return t; })() }}"
            },
            {
              "id": "a2",
              "name": "user_email",
              "type": "string",
              "value": "={{ $json.body.user_email }}"
            },
            {
              "id": "a3",
              "name": "user_name",
              "type": "string",
              "value": "={{ $json.body.user_name || 'there' }}"
            },
            {
              "id": "a4",
              "name": "file_name",
              "type": "string",
              "value": "={{ $json.body.file_name }}"
            },
            {
              "id": "a5",
              "name": "event_time",
              "type": "string",
              "value": "={{ $json.body.time || $now.toISO() }}"
            },
            {
              "id": "a6",
              "name": "deletion_date",
              "type": "string",
              "value": "={{ $json.body.deletion_date || '' }}"
            },
            {
              "id": "a7",
              "name": "error_message",
              "type": "string",
              "value": "={{ $json.body.error_message || $json.body.error || '' }}"
            }
          ]
        },
        "options": {}
      },
