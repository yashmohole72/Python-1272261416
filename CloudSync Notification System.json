      "id": "7c83d048-809f-4f0f-b8a1-c43845f6fcc7",
      "name": "Get Backed-up Files (Summary)",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        288,
        352
      ]
    },
    {
      "parameters": {
        "jsCode": "const tz = 'Asia/Kolkata';\nconst toDt = (v) => (v instanceof Date ? DateTime.fromJSDate(v) : DateTime.fromISO(String(v)));\nconst fmt = (v, f) => {\n  if (!v) return '-';\n  const d = toDt(v);\n  return d.isValid ? d.setZone(tz).toFormat(f) : String(v);\n};\nconst rows = $input.all().map((i) => i.json).filter((r) => r && r.user_email && r.backup_summary_sent !== true);\nconst byUser = {};\nfor (const r of rows) {\n  const key = String(r.user_email).trim().toLowerCase();\n  if (!byUser[key]) byUser[key] = { user_email: String(r.user_email).trim(), user_name: r.user_name || 'there', files: [] };\n  byUser[key].files.push(r);\n}\nreturn Object.values(byUser).map((u) => {\n  const rowsHtml = u.files\n    .map((f) => '<tr><td>' + f.file_name + '</td><td>' + fmt(f.event_time, 'dd LLL yyyy, HH:mm') + '</td><td>' + fmt(f.deletion_date, 'dd LLL yyyy') + '</td></tr>')\n    .join('');\n  const html =\n    '<p>Hi ' + u.user_name + ',</p>' +\n    '<p>Good news! CloudSync successfully backed up <b>' + u.files.length + '</b> file(s) since your last update:</p>' +\n    '<table border=\"1\" cellpadding=\"6\" cellspacing=\"0\" style=\"border-collapse:collapse\">' +\n    '<tr><th>File</th><th>Backed up at</th><th>Scheduled deletion</th></tr>' + rowsHtml + '</table>' +\n    '<p>Your files are safe in the cloud.</p><p>- The CloudSync Team</p>';\n  return {\n    json: {\n      user_email: u.user_email,\n      user_name: u.user_name,\n      file_count: u.files.length,\n      subject: 'CloudSync: ' + u.files.length + ' file(s) backed up successfully',\n      html,\n      row_ids: u.files.map((f) => f.id),\n    },\n  };\n});"
      },
